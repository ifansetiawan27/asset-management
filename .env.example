# ==========================================================
# AMS - Environment Variables (contoh). Salin ke .env
# ==========================================================

NODE_ENV=development
PORT=3000

# --- Database: APP runtime user (RLS ENFORCED, non-superuser) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ams
DB_USERNAME=ams_app
DB_PASSWORD=ams_app_pw

# --- Database: ADMIN user (untuk migrations & seed, owner) ---
DB_ADMIN_USERNAME=ams_admin
DB_ADMIN_PASSWORD=ams_admin_pw

# --- TLS koneksi DB (WAJIB untuk Supabase / DB terkelola) ---
# Set DB_SSL=true saat memakai Supabase. Selengkapnya lihat blok Supabase di bawah.
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=false
# DB_SSL_CA_PATH=./certs/prod-ca-2021.crt

# ==========================================================
# Supabase (contoh) — DB terkelola PostgreSQL
# Ambil dari: Supabase Dashboard > Project > Connect
# Gunakan "Session pooler" (IPv4-friendly, mendukung set_config transaksi).
#   Host    : aws-0-<region>.pooler.supabase.com
#   Port    : 5432
#   Database: postgres
# Runtime app -> role khusus non-superuser `ams_app` (lihat supabase/setup.sql):
#   DB_HOST=aws-0-<region>.pooler.supabase.com
#   DB_PORT=5432
#   DB_NAME=postgres
#   DB_USERNAME=ams_app.<project-ref>
#   DB_PASSWORD=<password ams_app yang Anda buat>
# Migrasi & seed -> role postgres (owner):
#   DB_ADMIN_USERNAME=postgres.<project-ref>
#   DB_ADMIN_PASSWORD=<database password proyek Supabase>
#   DB_SSL=true
#
# Alternatif "Direct connection" (IPv6, host db.<project-ref>.supabase.co:5432):
# username TANPA sufiks project-ref -> DB_USERNAME=ams_app, DB_ADMIN_USERNAME=postgres.
# ==========================================================

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- RabbitMQ ---
RABBITMQ_URL=amqp://ams:ams@localhost:5672

# --- Elasticsearch ---
ELASTICSEARCH_NODE=http://localhost:9200

# --- Object Storage (MinIO / S3) ---
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=ams_minio
S3_SECRET_KEY=ams_minio_pw
S3_BUCKET=ams-assets

# --- Autentikasi lokal (email/password + JWT diterbitkan API) ---
# WAJIB diganti dengan nilai acak yang kuat di produksi (minimal 32 karakter).
JWT_SECRET=ganti-dengan-secret-acak-min-32-karakter
JWT_EXPIRES_IN=8h
# Tenant default tempat semua akun didaftarkan (deployment single-tenant).
# Dibuat & di-bootstrap otomatis (tenant + 7 role) saat registrasi pertama.
AUTH_DEFAULT_TENANT_ID=11111111-1111-1111-1111-111111111111

# --- Keycloak (SSO) — OPSIONAL; tidak dipakai oleh auth email/password ---
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=ams
KEYCLOAK_CLIENT_ID=ams-web

# --- Asset Catalog (Module 1) ---
QR_SIGNING_SECRET=dev-qr-secret-change-me
STORAGE_DIR=uploads
